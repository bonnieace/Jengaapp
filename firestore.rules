rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(tenantId) {
      return signedIn() &&
        get(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)).data.status == 'active';
    }
    function ownsNewTenant() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }
    function eggStockBefore(tenantId, flockId) {
      let value = get(/databases/$(database)/documents/tenants/$(tenantId)/flocks/$(flockId)).data.get('eggStock', 0);
      return value is int ? value : 0;
    }
    function eggStockAfter(tenantId, flockId) {
      let value = getAfter(/databases/$(database)/documents/tenants/$(tenantId)/flocks/$(flockId)).data.get('eggStock', 0);
      return value is int ? value : 0;
    }

    function activeFlock(tenantId, flockId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/flocks/$(flockId)).data.active == true &&
        getAfter(/databases/$(database)/documents/tenants/$(tenantId)/flocks/$(flockId)).data.active == true;
    }
    function validFlock(data) {
      return data.keys().hasAll(['name', 'initialBirdCount', 'active', 'eggStock', 'startedAt', 'createdAt']) &&
        data.keys().hasOnly(['name', 'initialBirdCount', 'active', 'eggStock', 'startedAt', 'createdAt',
          'hatchedAt', 'closedAt', 'eggMutationId', 'eggMutationType', 'lifetimeGoodEggs',
          'lifetimeEggsSold', 'lifetimeEggRevenue', 'updatedAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.initialBirdCount is int && data.initialBirdCount > 0 && data.initialBirdCount <= 1000000 &&
        data.active is bool && data.eggStock is int && data.eggStock >= 0 &&
        data.startedAt is timestamp && data.createdAt is timestamp &&
        (!('hatchedAt' in data) || (data.hatchedAt is timestamp && data.hatchedAt <= request.time)) &&
        (!('closedAt' in data) || data.closedAt is timestamp);
    }

    match /users/{uid} {
      allow create, read, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /tenants/{tenantId} {
      allow create: if ownsNewTenant();
      allow read: if isMember(tenantId);
      allow update: if isMember(tenantId) &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /members/{uid} {
        allow create: if signedIn() && request.auth.uid == uid &&
          getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid &&
          request.resource.data.role == 'owner' && request.resource.data.status == 'active';
        allow read: if isMember(tenantId);
        allow update: if isMember(tenantId) &&
          get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid;
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        allow read, write: if isMember(tenantId);
      }

      match /workers/{workerId} {
        allow read, write: if isMember(tenantId);
      }

      match /flocks/{flockId} {
        allow read: if isMember(tenantId);
        allow create: if isMember(tenantId) && validFlock(request.resource.data) &&
          request.resource.data.active == true && request.resource.data.eggStock == 0;
        allow update: if isMember(tenantId) && validFlock(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.initialBirdCount == resource.data.initialBirdCount &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['active']) ||
            (eggStockBefore(tenantId, flockId) == 0 && request.resource.data.eggStock == 0)) &&
          (!('eggStock' in request.resource.data) ||
            (request.resource.data.eggStock is int && request.resource.data.eggStock >= 0)) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['eggStock']) ||
            (request.resource.data.eggMutationId is string &&
              ((request.resource.data.eggMutationType == 'production' &&
                getAfter(/databases/$(database)/documents/tenants/$(tenantId)/flocks/$(flockId)/eggProduction/$(request.resource.data.eggMutationId)).data.goodEggs is int) ||
               (request.resource.data.eggMutationType == 'sale' &&
                getAfter(/databases/$(database)/documents/tenants/$(tenantId)/flocks/$(flockId)/eggSales/$(request.resource.data.eggMutationId)).data.quantity is int) ||
               (request.resource.data.eggMutationType == 'adjustment' &&
                getAfter(/databases/$(database)/documents/tenants/$(tenantId)/flocks/$(flockId)/eggStockAdjustments/$(request.resource.data.eggMutationId)).data.delta is int))));
        allow delete: if false;

        match /mortalities/{mortalityId} {
          allow read: if isMember(tenantId);
          allow write: if isMember(tenantId) && activeFlock(tenantId, flockId);
        }

        match /vaccinations/{vaccinationId} {
          allow read: if isMember(tenantId);
          allow write: if isMember(tenantId) && activeFlock(tenantId, flockId);
        }

        match /eggProduction/{productionId} {
          allow read: if isMember(tenantId);
          allow create: if isMember(tenantId) && activeFlock(tenantId, flockId) &&
            request.resource.data.goodEggs is int && request.resource.data.goodEggs >= 0 &&
            request.resource.data.crackedEggs is int && request.resource.data.crackedEggs >= 0 &&
            request.resource.data.dirtyEggs is int && request.resource.data.dirtyEggs >= 0 &&
            request.resource.data.rejectedEggs is int && request.resource.data.rejectedEggs >= 0 &&
            request.resource.data.totalCollected ==
              request.resource.data.goodEggs + request.resource.data.crackedEggs +
              request.resource.data.dirtyEggs + request.resource.data.rejectedEggs &&
            eggStockAfter(tenantId, flockId) ==
              eggStockBefore(tenantId, flockId) + request.resource.data.goodEggs;
          allow update, delete: if false;
        }

        match /eggSales/{saleId} {
          allow read: if isMember(tenantId);
          allow create: if isMember(tenantId) && activeFlock(tenantId, flockId) &&
            request.resource.data.quantity is int && request.resource.data.quantity > 0 &&
            request.resource.data.quantity <= eggStockBefore(tenantId, flockId) &&
            request.resource.data.totalAmount ==
              request.resource.data.quantity * request.resource.data.unitPrice &&
            request.resource.data.paymentStatus in ['paid', 'partial', 'credit'] &&
            request.resource.data.amountPaid is number &&
            request.resource.data.amountPaid >= 0 &&
            request.resource.data.amountPaid <= request.resource.data.totalAmount &&
            request.resource.data.balanceDue ==
              request.resource.data.totalAmount - request.resource.data.amountPaid &&
            eggStockAfter(tenantId, flockId) ==
              eggStockBefore(tenantId, flockId) - request.resource.data.quantity;
          allow update, delete: if false;
        }

        match /eggStockAdjustments/{adjustmentId} {
          allow read: if isMember(tenantId);
          allow create: if isMember(tenantId) && activeFlock(tenantId, flockId) &&
            request.resource.data.delta is int && request.resource.data.delta != 0 &&
            request.resource.data.reason is string && request.resource.data.reason.size() >= 3 &&
            request.resource.data.stockBefore == eggStockBefore(tenantId, flockId) &&
            request.resource.data.stockAfter == eggStockAfter(tenantId, flockId) &&
            request.resource.data.stockAfter ==
              request.resource.data.stockBefore + request.resource.data.delta &&
            request.resource.data.stockAfter >= 0;
          allow update, delete: if false;
        }
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
